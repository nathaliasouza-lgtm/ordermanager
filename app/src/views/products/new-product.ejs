<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Produtos</title>
  <!-- O caminho busca direto a partir do interior da pasta public/ -->
  <link rel="stylesheet" href="../css/form-style.css">
</head>
<body>
    <div class="main_header">
        <h1>Order Manager</h1>
    </div>

    <div class="form-container">
        <div class="header-container">
            <h2>Cadastrar Produtos</h2>
        </div>
        <form action="/product" method="POST" class="form-card" id="new-prod">
            <div class="form-group">
                <label for="sku" >SKU*</label>
                <input type="text" id="sku" name="sku" required placeholder="Ex: TSH-NKE-NVY-M (Category-Brand-Color-Size)" required>
            </div>
            <div class="form-group">
                <label for="description">Description*</label>
                <input type="text" id="description" name="description" required placeholder="Navy Blue Nike T-Shirt M" required>
            </div>
            <div class="form-group">
                <label for="price">Price*</label>
                <input type="text" id="price" name="price" required placeholder="U$72.88" required>
                <span id="priceErr" class="errMessage" hidden></span>
            </div>
            <div class="form-group">
                <label for="storage_amt">Storage Amount</label>
                <input type="number" id="storage_amt" name="storage_amt" min="0" required>
            </div>
            <div class="form-group">
                <div id="cb_field">
                    <label for="activated">Activate Product</label>
                    <input type="checkbox" id="activated" name="activated">
                </div>
            </div>
            <div class="form-group">
                <span>
                    <label for="activation_date" hidden>Activation Date</label>
                    <input type="text" id="activation_date" name="activation_date" hidden readonly>
                </span>
            </div>
            <div class="form-actions">
                <button type="submit" class="btn-primary" id="add-product">Add Product</button>
                <a href="/product" class="btn-secondary">Back</a>
            </div>
        </form>
    </div>
  <script src="/../js/forms.js"></script>
</body>
</html>