<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Order Manager | New Order </title>
  <!-- O caminho busca direto a partir do interior da pasta public/ -->
  <link rel="stylesheet" href="../css/orders/form-style.css">
</head>
<body>
    <h1>Order Manager</h1>
    <div class="form-container">
        <h2>New Order Form</h2>
        <form action="/order" method="POST" class="form-card">
    <div class="form-group">
        <label for="order_number">Order Number</label>
        <input type="text" id="order_number" name="order_number" required placeholder="Ex: CSTMR-001">
    </div>
    <div class="form-group">
        <label for="customer">Customer</label>
        <div class="search-group">
            <input type="search" id="customer" name="customer" required>
            <input type="hidden" name="customer_token" id="token_input">
            <button  type="button" id="btn-search" class="btn-search">
                <svg id="Layer_1" data-name="Layer 1" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 128 128"><defs><style>.cls-1{fill:#2d3e50;}</style></defs><title>search customer</title><path class="cls-1" d="M120.5891,106.37506,96.5609,80.39355l-3.842,3.8457-4.35187-4.35187c.33368-.43195.667-.864.98346-1.30475A46.77661,46.77661,0,1,0,77.87956,89.85687q.99472-.68619,1.955-1.42987l4.34509,4.345-4.31427,4.31409,26.5097,23.5246a10.0585,10.0585,0,1,0,14.21405-14.23566ZM74.21977,74.22931a32.4793,32.4793,0,1,1,9.48859-22.94189A32.48241,32.48241,0,0,1,74.21977,74.22931Z"></path>
                </svg>
            </button>
    </div>
    </div>
    <!-- Modal de Busca de Clientes -->
    <div id="modal-customers" class="modal" tabindex="-1" style="display: none;">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Select Customer</h5>
                    <button type="button" class="close-modal" aria-label="Close">&times;</button>
                </div>
                
                <div class="modal-body">
                    <table class="table table-striped table-hover">
                    <thead>
                        <tr>
                        <th>Name</th>
                        <th>CPF</th>
                        <th class="text-center">Action</th>
                        </tr>
                    </thead>
                    <tbody id="customer-list">
                        <!-- As linhas serão inseridas via JavaScript -->
                    </tbody>
                    </table>
                </div>

                <div class="modal-footer d-flex justify-content-between">
                    <button id="prev-page" class="btn btn-sm btn-secondary" disabled>Previous</button>
                    <span id="page-info">Page 1</span>
                    <button id="next-page" class="btn btn-sm btn-secondary">Next</button>
                </div>
            </div>
        </div>
    </div>

    <div class="form-group">
        <label for="payment_date">Payment Date</label>
        <input type="datetime-local" id="payment_date" name="payment_date" required>
    </div>

    <div class="form-group">
        <label for="handling_deadline">Handling Deadline</label>
        <input type="datetime-local" id="handling_deadline" name="handling_deadline" required>
    </div>

    <div class="form-group">
        <label for="delivery_deadline">Delivery Deadline</label>
        <input type="datetime-local" id="delivery_deadline" name="delivery_deadline">
    </div>

    <div class="form-group">
        <label for="discount_percentage">Discount (%)</label>
        <input type="text" id="discount_percentage" name="discount_percentage">
    </div>


    <div class="form-group">
        <label for="discount_value">Discount Value</label>
        <input type="text" id="discount_value" name="discount_value">
    </div>

    <div class="form-group">
        <label for="shipping_fee">Shipping Fee</label>
        <input type="text" id="shipping_fee" name="shipping_fee">
    </div>

    <div class="form-group">
        <h3>Payment Method</h3>
        <div class="payment-option">
            <input type="radio" id="credit_card" name="payment_method" value="Credit Card">
            <label for="credit_card">Credit Card</label>
        </div>
        <div class="payment-option">
            <input type="radio" id="debit_card" name="payment_method" value="Debit Card">
            <label for="debit_card">Debit Card</label>
        </div>
        <div class="payment-option">
            <input type="radio" id="bank_transfer" name="payment_method" value="Bank Transfer">
            <label for="bank_transfer">Bank Transfer</label>
        </div>
    </div>

    <div class="form-group">
        <label for="status">Status</label>
        <select name="status" id="status">
            <option value="new">NEW</option>
            <option value="cancelled">CANCELLED</option>
            <option value="shipping">SHIPPING</option>
            <option value="handling">HANDLING</option>    
            <option value="delivered">DELIVERED</option>    
            <option value="payment_pending">PAYMENT PENDING</option>    
            <option value="refunded">REFUNDED</option>    
            <option value="returned">RETURNED</option>    
            <option value="expired">EXPIRED</option>            
            <option value="failed">FAILED</option>    
        </select>
    </div>
    <div class="form-group">
        <!-- INPUT DE BUSCA DE PRODUTOS -->

        <!-- TABELA COM OS PRODUTOS ADICIONADOS -->
    </div>
    <div class="form-group">
        <label for="payment_value">Total</label>
        <input type="text" id="payment_value" name="payment_value">
    </div>
    <div class="form-actions">
        <button type="submit" class="btn-primary">Add Order</button>
        <a href="/order" class="btn-secondary">Voltar</a>
    </div>
    </form>
    </div>

  <script src="/../js/orders/form.js"></script>
</body>
</html>