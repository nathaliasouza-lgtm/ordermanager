<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title> Order Manager | Customers </title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/nav.css">
  <link rel="stylesheet" href="../css/customers.css">
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Dashboard</a></li>
      <li><a href="/order">Orders</a></li>
      <li><a href="/customer">Customers</a></li>
      <li><a href="/product">Products</a></li>
    </ul>
  </nav>
  <div class="main_header">
    <h1>Order Manager</h1>
  </div>

  <div class="header-container">
    <h2>Customers</h2>
    <a href="/customer/new" class="btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      New Customer
    </a>
  </div>

  <div class="search-container">
    <form method="GET" action="/customer" class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="input-busca" name="search"value="<%= typeof search !== 'undefined' ? search : '' %>"placeholder="Buscar clientes por nome, cpf..."autocomplete="off">
    </form>
  </div>

  <table class="t-registros">
    <thead>
      <tr>
        <th>CPF</th>
        <th>Name</th>
        <th>E-mail</th>
        <th>Phone</th>
        <th>City / UF</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="tbody-data">
      <% if (customers.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align: center; padding: 16px;">Oops! There's no customers to display.</td>
        </tr>
      <% } %>
      <% customers.forEach(customer => { %>
        <tr data-customer-id="<%= customer.id %>">
          <td class="cell-customer-cpf"><%= customer.cpf %></td>
          <td class="cell-customer-name"><%= customer.name %></td>
          <td class="cell-customer-email"><%= customer.email %></td>
          <td class="cell-customer-phone"><%= customer.phone || '-' %></td>
          <td class="cell-customer-city">
            <%= [customer.city, customer.uf].filter(Boolean).join(' - ') || '-' %>
          </td>
          <td>
            <button type="button" class="btn-edit-customer" data-customer-id="<%= customer.id %>" title="Editar cliente">
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% 
    const queryPrefix = (typeof search !== 'undefined' && search) ? `search=${encodeURIComponent(search)}&` : '';
  %>
  <div class="pagination-container">
    <div class="pagination-info">
      Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> 
      (<%= totalItems %> customer<%= totalItems === 1 ? '' : 's' %>)
    </div>

    <div class="pagination-controls">
      <a 
        href="/customer?<%= queryPrefix %>page=<%= currentPage - 1 %>" 
        class="page-link <%= currentPage <= 1 ? 'disabled' : '' %>"
      >
        Previous
      </a>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="/customer?<%= queryPrefix %>page=<%= i %>" 
          class="page-link <%= i === currentPage ? 'active' : '' %>"
        >
          <%= i %>
        </a>
      <% } %>

      <a 
        href="/customer?<%= queryPrefix %>page=<%= currentPage + 1 %>" 
        class="page-link <%= currentPage >= totalPages ? 'disabled' : '' %>"
      >
        Next
      </a>
    </div>
  </div>

  <!-- Customer Edit Modal -->
  <div id="customer-modal" class="modal-overlay" inert>
    <div class="modal-container" role="dialog" aria-modal="true" aria-labelledby="modal-customer-title">
      <div class="modal-header">
        <h3 id="modal-customer-title">Edit Customer</h3>
      </div>

      <div id="modal-loading" class="modal-body">Loading customer data...</div>

      <form id="customer-edit-form" style="display: none;">
        <div class="modal-body">

          <!-- 1. Personal & Contact Information -->
          <section class="modal-section">
            <h4 class="section-title">Personal Data & Contact</h4>
            <div class="grid-2-col">
              <div class="form-field">
                <label for="edit-name">Full Name*</label>
                <input type="text" id="edit-name" name="name" required>
              </div>
              <div class="form-field">
                <label for="edit-cpf">CPF *</label>
                <input type="text" id="edit-cpf" name="cpf" required>
              </div>
            </div>

            <div class="grid-2-col section-row-divider">
              <div class="form-field">
                <label for="edit-email">E-mail</label>
                <input type="email" id="edit-email" name="email">
              </div>
              <div class="form-field">
                <label for="edit-phone">Phone</label>
                <input type="text" id="edit-phone" name="phone">
              </div>
            </div>
          </section>

          <!-- 2. Address Information -->
          <section class="modal-section">
            <h4 class="section-title">Address Information</h4>
            <div class="grid-address">
              <div class="form-field">
                <label for="edit-zipcode">CEP</label>
                <input type="text" id="edit-zipcode" name="zipcode">
              </div>
              <div class="form-field">
                <label for="edit-address">Address</label>
                <input type="text" id="edit-address" name="address">
              </div>
              <div class="form-field">
                <label for="edit-residence-number">Number</label>
                <input type="text" id="edit-residence-number" name="residence_number">
              </div>
            </div>

            <div class="grid-address section-row-divider">
              <div class="form-field">
                <label for="edit-neighborhood">Neighborhood</label>
                <input type="text" id="edit-neighborhood" name="neighborhood">
              </div>
              <div class="form-field">
                <label for="edit-city">City</label>
                <input type="text" id="edit-city" name="city">
              </div>
              <div class="form-field">
                <label for="edit-state">State</label>
                <input type="text" id="edit-state" name="state">
              </div>
              <div class="form-field">
                <label for="edit-uf">UF</label>
                <input type="text" id="edit-uf" name="uf" maxlength="2">
              </div>
            </div>
          </section>

        </div>

        <div class="modal-footer">
          <div class="modal-footer-actions">
            <button type="button" id="btn-cancel-modal" class="btn-cancel-modal">Cancel</button>
            <button type="submit" id="btn-save-customer" class="btn-save-customer">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script src="/../js/main.js"></script>
  <script src="/../js/customers/customers.js"></script>
</body>
</html>