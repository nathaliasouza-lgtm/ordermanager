<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title> Order Manager | Customers </title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/nav.css">
  <style>
    .btn-edit-customer {
      background: transparent;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      padding: 6px 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #374151;
      transition: all 0.15s ease;
    }
    .btn-edit-customer:hover {
      background-color: #2563eb;
      border-color: #2563eb;
      color: #ffffff;
    }

    /* Pagination Styles */
    .pagination-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .pagination-info {
      font-size: 0.9rem;
      color: #4b5563;
    }
    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .page-link {
      padding: 6px 12px;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      text-decoration: none;
      color: #111827;
      background-color: #fff;
      font-size: 0.875rem;
    }
    .page-link:hover:not(.disabled):not(.active) {
      background-color: #f3f4f6;
    }
    .page-link.active {
      background-color: #2563eb;
      color: #fff;
      border-color: #2563eb;
      font-weight: 600;
    }
    .page-link.disabled {
      pointer-events: none;
      opacity: 0.5;
    }

    /* Customer Edit Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(2px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-container {
      background: #ffffff;
      border-radius: 12px;
      width: 95%;
      max-width: 860px;
      max-height: 92vh;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
      animation: modalFadeIn 0.18s ease-out;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-header {
      padding: 20px 28px;
      border-bottom: 1px solid #e2e8f0;
    }
    .modal-header h3 {
      margin: 0;
      font-size: 1.3rem;
      color: #0f172a;
    }
    .modal-body {
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 20px;
    }
    .modal-section {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 20px 22px;
      width: 100%;
      box-sizing: border-box;
    }
    .section-title {
      font-size: 0.92rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #1e293b;
      margin: 0 0 16px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid #e2e8f0;
    }
    .grid-2-col {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 24px;
    }
    .grid-address {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 16px 20px;
    }
    .section-row-divider {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px dashed #cbd5e1;
    }
    .form-field {
      display: flex;
      flex-direction: column;
      gap: 6px;
    }
    .form-field label {
      font-size: 0.76rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #64748b;
    }
    .form-field input {
      width: 100%;
      box-sizing: border-box;
      padding: 9px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background-color: #ffffff;
      font-size: 0.95rem;
      color: #0f172a;
      transition: border-color 0.15s ease;
    }
    .form-field input:focus {
      outline: none;
      border-color: #2563eb;
      box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.12);
    }

    /* Footer Buttons grouped closely on the right */
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding: 18px 28px;
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
    }
    .modal-footer-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-cancel-modal,
    .btn-save-customer {
      width: auto;
      min-width: 96px;
      border: none;
      border-radius: 6px;
      padding: 10px 18px;
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .btn-cancel-modal {
      background-color: #e2e8f0;
      color: #1e293b;
    }
    .btn-cancel-modal:hover {
      background-color: #cbd5e1;
    }
    .btn-save-customer {
      background-color: #2563eb;
      color: #ffffff;
    }
    .btn-save-customer:hover:not(:disabled) {
      background-color: #1d4ed8;
    }
    .btn-save-customer:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Dashboard</a></li>
      <li><a href="/order">Orders</a></li>
      <li><a href="/customer">Customers</a></li>
      <li><a href="/product">Products</a></li>
    </ul>
  </nav>

  <div class="main_header">
    <h1>Order Manager</h1>
  </div>

  <div class="header-container">
    <h2>Customers</h2>
    <a href="/customer/new" class="btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      New Customer
    </a>
  </div>

  <div class="search-container">
    <form method="GET" action="/customer" class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="input-busca" 
        name="search"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
        placeholder="Buscar clientes por nome, cpf..."
        autocomplete="off"
      >
    </form>
  </div>

  <table class="t-registros">
    <thead>
      <tr>
        <th>CPF</th>
        <th>Nome</th>
        <th>E-mail</th>
        <th>Telefone</th>
        <th>Cidade / UF</th>
        <th>Ações</th>
      </tr>
    </thead>
    <tbody id="tbody-data">
      <% if (customers.length === 0) { %>
        <tr>
          <td colspan="6" style="text-align: center; padding: 16px;">Nenhum cliente encontrado.</td>
        </tr>
      <% } %>
      <% customers.forEach(customer => { %>
        <tr data-customer-id="<%= customer.id %>">
          <td class="cell-customer-cpf"><%= customer.cpf %></td>
          <td class="cell-customer-name"><%= customer.name %></td>
          <td class="cell-customer-email"><%= customer.email %></td>
          <td class="cell-customer-phone"><%= customer.phone || '-' %></td>
          <td class="cell-customer-city">
            <%= [customer.city, customer.uf].filter(Boolean).join(' - ') || '-' %>
          </td>
          <td>
            <button 
              type="button" 
              class="btn-edit-customer" 
              data-customer-id="<%= customer.id %>" 
              title="Editar cliente"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"></path>
              </svg>
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% 
    const queryPrefix = (typeof search !== 'undefined' && search) ? `search=${encodeURIComponent(search)}&` : '';
  %>
  <div class="pagination-container">
    <div class="pagination-info">
      Página <strong><%= currentPage %></strong> de <strong><%= totalPages %></strong> 
      (<%= totalItems %> cliente<%= totalItems === 1 ? '' : 's' %>)
    </div>

    <div class="pagination-controls">
      <a 
        href="/customer?<%= queryPrefix %>page=<%= currentPage - 1 %>" 
        class="page-link <%= currentPage <= 1 ? 'disabled' : '' %>"
      >
        Anterior
      </a>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="/customer?<%= queryPrefix %>page=<%= i %>" 
          class="page-link <%= i === currentPage ? 'active' : '' %>"
        >
          <%= i %>
        </a>
      <% } %>

      <a 
        href="/customer?<%= queryPrefix %>page=<%= currentPage + 1 %>" 
        class="page-link <%= currentPage >= totalPages ? 'disabled' : '' %>"
      >
        Próxima
      </a>
    </div>
  </div>

  <!-- Customer Edit Modal -->
  <div id="customer-modal" class="modal-overlay" inert>
    <div class="modal-container" role="dialog" aria-modal="true" aria-labelledby="modal-customer-title">
      <div class="modal-header">
        <h3 id="modal-customer-title">Editar Cliente</h3>
      </div>

      <div id="modal-loading" class="modal-body">Carregando dados do cliente...</div>

      <form id="customer-edit-form" style="display: none;">
        <div class="modal-body">

          <!-- 1. Personal & Contact Information -->
          <section class="modal-section">
            <h4 class="section-title">Dados Pessoais & Contato</h4>
            <div class="grid-2-col">
              <div class="form-field">
                <label for="edit-name">Nome Completo *</label>
                <input type="text" id="edit-name" name="name" required>
              </div>
              <div class="form-field">
                <label for="edit-cpf">CPF *</label>
                <input type="text" id="edit-cpf" name="cpf" required>
              </div>
            </div>

            <div class="grid-2-col section-row-divider">
              <div class="form-field">
                <label for="edit-email">E-mail</label>
                <input type="email" id="edit-email" name="email">
              </div>
              <div class="form-field">
                <label for="edit-phone">Telefone</label>
                <input type="text" id="edit-phone" name="phone">
              </div>
            </div>
          </section>

          <!-- 2. Address Information -->
          <section class="modal-section">
            <h4 class="section-title">Endereço</h4>
            <div class="grid-address">
              <div class="form-field">
                <label for="edit-zipcode">CEP</label>
                <input type="text" id="edit-zipcode" name="zipcode">
              </div>
              <div class="form-field">
                <label for="edit-address">Logradouro / Rua</label>
                <input type="text" id="edit-address" name="address">
              </div>
              <div class="form-field">
                <label for="edit-residence-number">Número</label>
                <input type="text" id="edit-residence-number" name="residence_number">
              </div>
            </div>

            <div class="grid-address section-row-divider">
              <div class="form-field">
                <label for="edit-neighborhood">Bairro</label>
                <input type="text" id="edit-neighborhood" name="neighborhood">
              </div>
              <div class="form-field">
                <label for="edit-city">Cidade</label>
                <input type="text" id="edit-city" name="city">
              </div>
              <div class="form-field">
                <label for="edit-state">Estado</label>
                <input type="text" id="edit-state" name="state">
              </div>
              <div class="form-field">
                <label for="edit-uf">UF</label>
                <input type="text" id="edit-uf" name="uf" maxlength="2">
              </div>
            </div>
          </section>

        </div>

        <div class="modal-footer">
          <div class="modal-footer-actions">
            <button type="button" id="btn-cancel-modal" class="btn-cancel-modal">Cancel</button>
            <button type="submit" id="btn-save-customer" class="btn-save-customer">Save</button>
          </div>
        </div>
      </form>
    </div>
  </div>

  <script src="/../js/main.js"></script>
  <script>
    const modal = document.getElementById('customer-modal');
    const modalLoading = document.getElementById('modal-loading');
    const editForm = document.getElementById('customer-edit-form');
    const saveBtn = document.getElementById('btn-save-customer');
    let currentCustomerId = null;
    let lastTriggerButton = null;

    function openModal(triggerBtn) {
      lastTriggerButton = triggerBtn || document.activeElement;
      modal.removeAttribute('inert');
      modal.classList.add('active');
    }

    function closeModal() {
      if (modal.contains(document.activeElement)) {
        document.activeElement.blur();
      }
      modal.setAttribute('inert', '');
      modal.classList.remove('active');
      currentCustomerId = null;

      if (lastTriggerButton && typeof lastTriggerButton.focus === 'function') {
        lastTriggerButton.focus();
      }
    }

    document.getElementById('btn-cancel-modal').addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Open modal and load full customer data when clicking the edit icon
    document.getElementById('tbody-data').addEventListener('click', async (event) => {
      const btn = event.target.closest('.btn-edit-customer');
      if (!btn) return;

      currentCustomerId = btn.dataset.customerId;
      modalLoading.style.display = 'block';
      editForm.style.display = 'none';
      openModal(btn);

      try {
        const res = await fetch(`/customer/${encodeURIComponent(currentCustomerId)}`, {
          headers: { 'Accept': 'application/json' }
        });
        const customer = await res.json();

        if (!res.ok) {
          throw new Error(customer.error || 'Erro ao carregar dados do cliente.');
        }

        document.getElementById('modal-customer-title').textContent = `Editar Cliente — ${customer.name}`;
        document.getElementById('edit-name').value = customer.name || '';
        document.getElementById('edit-cpf').value = customer.cpf || '';
        document.getElementById('edit-email').value = customer.email || '';
        document.getElementById('edit-phone').value = customer.phone || '';
        document.getElementById('edit-zipcode').value = customer.zipcode || '';
        document.getElementById('edit-address').value = customer.address || '';
        document.getElementById('edit-residence-number').value = customer.residence_number || '';
        document.getElementById('edit-neighborhood').value = customer.neighborhood || '';
        document.getElementById('edit-city').value = customer.city || '';
        document.getElementById('edit-state').value = customer.state || '';
        document.getElementById('edit-uf').value = customer.uf || '';

        modalLoading.style.display = 'none';
        editForm.style.display = 'block';
      } catch (err) {
        alert(err.message);
        closeModal();
      }
    });

    // Save updated customer details via PATCH /customer/:id
    editForm.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!currentCustomerId) return;

      const payload = {
        name: document.getElementById('edit-name').value,
        cpf: document.getElementById('edit-cpf').value,
        email: document.getElementById('edit-email').value,
        phone: document.getElementById('edit-phone').value,
        zipcode: document.getElementById('edit-zipcode').value,
        address: document.getElementById('edit-address').value,
        residence_number: document.getElementById('edit-residence-number').value,
        neighborhood: document.getElementById('edit-neighborhood').value,
        city: document.getElementById('edit-city').value,
        state: document.getElementById('edit-state').value,
        uf: document.getElementById('edit-uf').value
      };

      saveBtn.disabled = true;
      saveBtn.textContent = 'Saving...';

      try {
        const res = await fetch(`/customer/${encodeURIComponent(currentCustomerId)}`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify(payload)
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Erro ao atualizar cliente.');
        }

        // Update table row in place without reloading
        const tableRow = document.querySelector(`#tbody-data tr[data-customer-id="${currentCustomerId}"]`);
        if (tableRow) {
          tableRow.querySelector('.cell-customer-cpf').textContent = data.customer.cpf;
          tableRow.querySelector('.cell-customer-name').textContent = data.customer.name;
          tableRow.querySelector('.cell-customer-email').textContent = data.customer.email || '-';
          tableRow.querySelector('.cell-customer-phone').textContent = data.customer.phone || '-';
          tableRow.querySelector('.cell-customer-city').textContent =
            [data.customer.city, data.customer.uf].filter(Boolean).join(' - ') || '-';
        }

        closeModal();
      } catch (err) {
        alert(err.message);
      } finally {
        saveBtn.disabled = false;
        saveBtn.textContent = 'Save';
      }
    });
  </script>
</body>
</html>