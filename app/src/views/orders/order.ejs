<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title> Order Manager | Orders </title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/nav.css">
  <style>
    .btn-view-order {
      background: transparent;
      border: 1px solid #d1d5db;
      border-radius: 6px;
      padding: 6px 8px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      color: #374151;
      transition: all 0.15s ease;
    }
    .btn-view-order:hover {
      background-color: #2563eb;
      border-color: #2563eb;
      color: #ffffff;
    }

    /* Pagination Styles */
    .pagination-container {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-top: 16px;
      flex-wrap: wrap;
      gap: 12px;
    }
    .pagination-info {
      font-size: 0.9rem;
      color: #4b5563;
    }
    .pagination-controls {
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .page-link {
      padding: 6px 12px;
      border: 1px solid #d1d5db;
      border-radius: 4px;
      text-decoration: none;
      color: #111827;
      background-color: #fff;
      font-size: 0.875rem;
    }
    .page-link:hover:not(.disabled):not(.active) {
      background-color: #f3f4f6;
    }
    .page-link.active {
      background-color: #2563eb;
      color: #fff;
      border-color: #2563eb;
      font-weight: 600;
    }
    .page-link.disabled {
      pointer-events: none;
      opacity: 0.5;
    }

    /* Spacious Order Details Modal */
    .modal-overlay {
      display: none;
      position: fixed;
      inset: 0;
      background-color: rgba(15, 23, 42, 0.6);
      backdrop-filter: blur(2px);
      z-index: 1000;
      align-items: center;
      justify-content: center;
      padding: 24px;
    }
    .modal-overlay.active {
      display: flex;
    }
    .modal-container {
      background: #ffffff;
      border-radius: 12px;
      width: 95%;
      max-width: 960px;
      max-height: 92vh;
      overflow-y: auto;
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.15), 0 8px 10px -6px rgba(0, 0, 0, 0.1);
      animation: modalFadeIn 0.18s ease-out;
    }
    @keyframes modalFadeIn {
      from { opacity: 0; transform: translateY(-8px); }
      to { opacity: 1; transform: translateY(0); }
    }
    .modal-header {
      padding: 20px 28px;
      border-bottom: 1px solid #e2e8f0;
    }
    .modal-header h3 {
      margin: 0;
      font-size: 1.3rem;
      color: #0f172a;
    }
    .modal-body {
      padding: 24px 28px;
      display: flex;
      flex-direction: column;
      gap: 22px;
    }
    .modal-section {
      background-color: #f8fafc;
      border: 1px solid #e2e8f0;
      border-radius: 10px;
      padding: 20px 22px;
      width: 100%;
      box-sizing: border-box;
    }
    .section-title {
      font-size: 0.92rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #1e293b;
      margin: 0 0 16px 0;
      padding-bottom: 10px;
      border-bottom: 1px solid #e2e8f0;
    }

    /* Grid layouts for each section */
    .grid-2-col {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px 24px;
    }
    .grid-3-col {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 16px 24px;
    }
    .grid-address {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
      gap: 16px 20px;
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px dashed #cbd5e1;
    }
    .section-row-divider {
      margin-top: 16px;
      padding-top: 16px;
      border-top: 1px dashed #cbd5e1;
    }
    .detail-item {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .detail-label {
      font-size: 0.76rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.04em;
      color: #64748b;
    }
    .detail-value {
      font-size: 0.96rem;
      font-weight: 500;
      color: #0f172a;
      word-break: break-word;
    }

    /* Full-width Products Table */
    .items-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 0.94rem;
      background-color: #ffffff;
      border: 1px solid #e2e8f0;
      border-radius: 8px;
      overflow: hidden;
    }
    .items-table th {
      background-color: #f1f5f9;
      color: #475569;
      font-weight: 600;
      text-align: left;
      padding: 12px 16px;
      border-bottom: 1px solid #cbd5e1;
    }
    .items-table td {
      padding: 12px 16px;
      border-bottom: 1px solid #e2e8f0;
      color: #334155;
    }
    .items-table tr:last-child td {
      border-bottom: none;
    }

    .status-select {
      width: 100%;
      padding: 8px 12px;
      border: 1px solid #cbd5e1;
      border-radius: 6px;
      background-color: #ffffff;
      font-size: 0.92rem;
      color: #0f172a;
    }

    /* Footer Buttons grouped closely on the right */
    .modal-footer {
      display: flex;
      justify-content: flex-end;
      align-items: center;
      padding: 18px 28px;
      background-color: #f8fafc;
      border-top: 1px solid #e2e8f0;
      border-bottom-left-radius: 12px;
      border-bottom-right-radius: 12px;
    }
    .modal-footer-actions {
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }
    .btn-cancel-modal,
    .btn-save-status {
      width: auto;
      min-width: 96px;
      border: none;
      border-radius: 6px;
      padding: 10px 18px;
      font-size: 0.92rem;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 0.15s ease;
    }
    .btn-cancel-modal {
      background-color: #e2e8f0;
      color: #1e293b;
    }
    .btn-cancel-modal:hover {
      background-color: #cbd5e1;
    }
    .btn-save-status {
      background-color: #2563eb;
      color: #ffffff;
    }
    .btn-save-status:hover:not(:disabled) {
      background-color: #1d4ed8;
    }
    .btn-save-status:disabled {
      opacity: 0.6;
      cursor: not-allowed;
    }
  </style>
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Dashboard</a></li>
      <li><a href="/order">Orders</a></li>
      <li><a href="/customer">Customers</a></li>
      <li><a href="/product">Products</a></li>
    </ul>
  </nav>

  <div class="main_header">
    <h1>Order Manager</h1>
  </div>

  <div class="header-container">
    <h2> Orders </h2>
    <a href="/order/new" class="btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      New Order
    </a>
  </div>

  <div class="search-container">
    <form method="GET" action="/order" class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input 
        type="text" 
        id="input-busca" 
        name="search"
        value="<%= typeof search !== 'undefined' ? search : '' %>"
        placeholder="Search orders by order number..."
        autocomplete="off"
      >
    </form>
  </div>
  
  <%
    const formatBRL = (val) =>
      Number(val || 0).toLocaleString('pt-BR', { style: 'currency', currency: 'BRL' });
  %>
  <table class="t-registros">
    <thead>
      <tr>
        <th>Order Number</th>
        <th>Status</th>
        <th>Payment Method</th>
        <th>Payment Date</th>
        <th>Handling Deadline</th>
        <th>Delivery Deadline</th>
        <th>Discount (%)</th>
        <th>Shipping Fee</th>
        <th>Total</th>
        <th>Actions</th>
      </tr>
    </thead>

    <tbody id="tbody-data">
      <% if (order.length === 0) { %>
        <tr>
          <td colspan="10" style="text-align: center; padding: 16px;">No orders found.</td>
        </tr>
      <% } %>
      <% order.forEach(record => { %>
        <tr data-order-id="<%= record.id %>">
          <td><%= record.order_number %></td>
          <td class="cell-order-status"><%= record.status %></td>
          <td><%= record.payment_method %></td>
          <td><%= record.payment_date %></td>
          <td><%= record.handling_deadline %></td>
          <td><%= record.delivery_deadline %></td>
          <td><%= record.discount_percentage %>%</td>
          <td><%= formatBRL(record.shipping_fee) %></td>
          <td><%= formatBRL(record.payment_value) %></td>
          <td>
            <button 
              type="button" 
              class="btn-view-order" 
              data-order-id="<%= record.id %>" 
              title="View order details"
            >
              <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </button>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% 
    const queryPrefix = (typeof search !== 'undefined' && search) ? `search=${encodeURIComponent(search)}&` : '';
  %>
  <div class="pagination-container">
    <div class="pagination-info">
      Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> 
      (<%= totalItems %> order<%= totalItems === 1 ? '' : 's' %>)
    </div>

    <div class="pagination-controls">
      <a 
        href="/order?<%= queryPrefix %>page=<%= currentPage - 1 %>" 
        class="page-link <%= currentPage <= 1 ? 'disabled' : '' %>"
      >
        Previous
      </a>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="/order?<%= queryPrefix %>page=<%= i %>" 
          class="page-link <%= i === currentPage ? 'active' : '' %>"
        >
          <%= i %>
        </a>
      <% } %>

      <a 
        href="/order?<%= queryPrefix %>page=<%= currentPage + 1 %>" 
        class="page-link <%= currentPage >= totalPages ? 'disabled' : '' %>"
      >
        Next
      </a>
    </div>
  </div>

  <!-- Order Details Modal -->
  <div id="order-modal" class="modal-overlay" inert>
    <div class="modal-container" role="dialog" aria-modal="true" aria-labelledby="modal-order-title">
      <div class="modal-header">
        <h3 id="modal-order-title">Order Details</h3>
      </div>

      <div id="modal-loading" class="modal-body">Loading order details...</div>

      <div id="modal-content" style="display: none;">
        <div class="modal-body">

          <!-- 1. Customer Information -->
          <section class="modal-section">
            <h4 class="section-title">Customer Information</h4>

            <!-- Name & CPF side by side -->
            <div class="grid-2-col">
              <div class="detail-item">
                <span class="detail-label">Name</span>
                <span class="detail-value" id="modal-customer-name">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">CPF</span>
                <span class="detail-value" id="modal-customer-cpf">-</span>
              </div>
            </div>

            <!-- Address, Residence Number, Neighborhood, City, Additional Info side by side (wraps if needed) -->
            <div class="grid-address">
              <div class="detail-item">
                <span class="detail-label">Address</span>
                <span class="detail-value" id="modal-customer-address">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Residence Number</span>
                <span class="detail-value" id="modal-customer-number">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Neighborhood</span>
                <span class="detail-value" id="modal-customer-neighborhood">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">City</span>
                <span class="detail-value" id="modal-customer-city">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Address Info / Complement</span>
                <span class="detail-value" id="modal-customer-info">-</span>
              </div>
            </div>
          </section>

          <!-- 2. Order Information -->
          <section class="modal-section">
            <h4 class="section-title">Order Information</h4>

            <!-- Current Status & Payment Method side by side -->
            <div class="grid-2-col">
              <div class="detail-item">
                <span class="detail-label">Current Status</span>
                <span class="detail-value" id="modal-current-status">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Payment Method</span>
                <span class="detail-value" id="modal-payment-method">-</span>
              </div>
            </div>

            <!-- Dates & Deadlines side by side below -->
            <div class="grid-3-col section-row-divider">
              <div class="detail-item">
                <span class="detail-label">Payment Date</span>
                <span class="detail-value" id="modal-payment-date">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Handling Deadline</span>
                <span class="detail-value" id="modal-handling-deadline">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Delivery Deadline</span>
                <span class="detail-value" id="modal-delivery-deadline">-</span>
              </div>
            </div>
          </section>

          <!-- 3. Products Information -->
          <section class="modal-section">
            <h4 class="section-title">Products</h4>
            <table class="items-table">
              <thead>
                <tr>
                  <th>SKU</th>
                  <th>Product</th>
                  <th>Qty</th>
                  <th>Unit Price</th>
                  <th>Subtotal</th>
                </tr>
              </thead>
              <tbody id="modal-items-body"></tbody>
            </table>
          </section>

          <!-- 4. Totals, Fees & Status Update -->
          <section class="modal-section">
            <h4 class="section-title">Summary & Status</h4>

            <!-- Shipping Fee & Discounts side by side -->
            <div class="grid-2-col">
              <div class="detail-item">
                <span class="detail-label">Shipping Fee</span>
                <span class="detail-value" id="modal-shipping-fee">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Discounts</span>
                <span class="detail-value" id="modal-discount">-</span>
              </div>
            </div>

            <!-- Subtotal, Total & Update Status side by side -->
            <div class="grid-3-col section-row-divider">
              <div class="detail-item">
                <span class="detail-label">Subtotal</span>
                <span class="detail-value" id="modal-subtotal">-</span>
              </div>
              <div class="detail-item">
                <span class="detail-label">Total</span>
                <span class="detail-value" id="modal-payment-value">-</span>
              </div>
              <div class="detail-item">
                <label class="detail-label" for="modal-status-select">Update Status</label>
                <select id="modal-status-select" class="status-select">
                  <option value="new">New</option>
                  <option value="payment pending">Payment Pending</option>
                  <option value="handling">Handling</option>
                  <option value="shipping">Shipping</option>
                  <option value="delivered">Delivered</option>
                  <option value="cancelled">Cancelled</option>
                  <option value="returned">Returned</option>
                  <option value="refunded">Refunded</option>
                  <option value="failed">Failed</option>
                  <option value="expired">Expired</option>
                </select>
              </div>
            </div>
          </section>

        </div>

        <div class="modal-footer">
          <div class="modal-footer-actions">
            <button type="button" id="btn-cancel-modal" class="btn-cancel-modal">Cancel</button>
            <button type="button" id="btn-save-order-status" class="btn-save-status">Save</button>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script src="/../js/main.js"></script>
  <script>
    const modal = document.getElementById('order-modal');
    const modalLoading = document.getElementById('modal-loading');
    const modalContent = document.getElementById('modal-content');
    const statusSelect = document.getElementById('modal-status-select');
    const saveStatusBtn = document.getElementById('btn-save-order-status');
    let currentOrderId = null;
    let lastTriggerButton = null;

    const currencyFormatter = new Intl.NumberFormat('pt-BR', {
      style: 'currency',
      currency: 'BRL'
    });

    function formatCurrency(value) {
      const numeric = Number(value);
      return currencyFormatter.format(Number.isFinite(numeric) ? numeric : 0);
    }

    function openModal(triggerBtn) {
      lastTriggerButton = triggerBtn || document.activeElement;
      modal.removeAttribute('inert');
      modal.classList.add('active');
    }

    function closeModal() {
      if (modal.contains(document.activeElement)) {
        document.activeElement.blur();
      }
      modal.setAttribute('inert', '');
      modal.classList.remove('active');
      currentOrderId = null;

      if (lastTriggerButton && typeof lastTriggerButton.focus === 'function') {
        lastTriggerButton.focus();
      }
    }

    document.getElementById('btn-cancel-modal').addEventListener('click', closeModal);
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });

    // Open modal and fetch details when clicking the eye icon
    document.getElementById('tbody-data').addEventListener('click', async (event) => {
      const btn = event.target.closest('.btn-view-order');
      if (!btn) return;

      currentOrderId = btn.dataset.orderId;
      modalLoading.style.display = 'block';
      modalContent.style.display = 'none';
      openModal(btn);

      try {
        const res = await fetch(`/orders/${encodeURIComponent(currentOrderId)}/details`, {
          headers: { 'Accept': 'application/json' }
        });
        const order = await res.json();

        if (!res.ok) {
          throw new Error(order.error || 'Failed to load order details.');
        }

        const customer = order.customers || {};
        const items = order.items || [];

        // 1. Customer Information
        document.getElementById('modal-customer-name').textContent = customer.name || 'N/A';
        document.getElementById('modal-customer-cpf').textContent = customer.cpf || '-';
        document.getElementById('modal-customer-address').textContent =
          customer.address || customer.street || customer.logradouro || '-';
        document.getElementById('modal-customer-number').textContent =
          customer.residence_number || customer.address_number || customer.number || customer.numero || '-';
        document.getElementById('modal-customer-neighborhood').textContent =
          customer.neighborhood || customer.bairro || '-';
        document.getElementById('modal-customer-city').textContent =
          customer.city || customer.cidade || '-';

        const extraAddressInfo = [
          customer.address_info || customer.complement || customer.complemento,
          customer.state || customer.estado || customer.uf,
          customer.zip_code || customer.cep ? `CEP: ${customer.zip_code || customer.cep}` : ''
        ].filter(Boolean).join(' | ');
        document.getElementById('modal-customer-info').textContent = extraAddressInfo || '-';

        // 2. Order Information
        document.getElementById('modal-order-title').textContent = `Order #${order.order_number}`;
        document.getElementById('modal-current-status').textContent = order.status || '-';
        document.getElementById('modal-payment-method').textContent = order.payment_method || '-';
        document.getElementById('modal-payment-date').textContent = order.payment_date || '-';
        document.getElementById('modal-handling-deadline').textContent = order.handling_deadline || '-';
        document.getElementById('modal-delivery-deadline').textContent = order.delivery_deadline || '-';

        // 3. Products Information
        const itemsBody = document.getElementById('modal-items-body');
        if (items.length === 0) {
          itemsBody.innerHTML = '<tr><td colspan="5">No items found for this order.</td></tr>';
        } else {
          itemsBody.innerHTML = items.map(item => `
            <tr>
              <td>${item.products?.sku || '-'}</td>
              <td>${item.products?.description || '-'}</td>
              <td>${item.amount}</td>
              <td>${formatCurrency(item.unit_price)}</td>
              <td>${formatCurrency(item.total_price)}</td>
            </tr>
          `).join('');
        }

        // 4. Summary & Status
        const itemsSubtotal = items.reduce((sum, item) => sum + (Number(item.total_price) || 0), 0);
        document.getElementById('modal-shipping-fee').textContent = formatCurrency(order.shipping_fee);
        document.getElementById('modal-discount').textContent =
          `${order.discount_percentage ?? 0}% (${formatCurrency(order.discount_value)})`;
        document.getElementById('modal-subtotal').textContent = formatCurrency(itemsSubtotal);
        document.getElementById('modal-payment-value').textContent = formatCurrency(order.payment_value);

        const normalizedStatus = String(order.status || '').trim().toLowerCase();
        const matchingOption = Array.from(statusSelect.options).find(
          opt => opt.value.toLowerCase() === normalizedStatus
        );
        if (matchingOption) {
          statusSelect.value = matchingOption.value;
        }

        modalLoading.style.display = 'none';
        modalContent.style.display = 'block';
      } catch (err) {
        alert(err.message);
        closeModal();
      }
    });

    // Save updated status via PATCH /orders/:id/status
    saveStatusBtn.addEventListener('click', async () => {
      if (!currentOrderId) return;

      const newStatus = statusSelect.value;
      saveStatusBtn.disabled = true;
      saveStatusBtn.textContent = 'Saving...';

      try {
        const res = await fetch(`/orders/${encodeURIComponent(currentOrderId)}/status`, {
          method: 'PATCH',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({ status: newStatus })
        });

        const data = await res.json();

        if (!res.ok) {
          throw new Error(data.error || 'Failed to update status.');
        }

        const tableRow = document.querySelector(`#tbody-data tr[data-order-id="${currentOrderId}"]`);
        if (tableRow) {
          tableRow.querySelector('.cell-order-status').textContent = data.status;
        }

        closeModal();
      } catch (err) {
        alert(err.message);
      } finally {
        saveStatusBtn.disabled = false;
        saveStatusBtn.textContent = 'Save';
      }
    });
  </script>
</body>
</html>