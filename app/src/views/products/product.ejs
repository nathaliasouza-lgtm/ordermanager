<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Produtos</title>
  <link rel="stylesheet" href="../css/style.css">
  <link rel="stylesheet" href="../css/nav.css">
  <link rel="stylesheet" href="../css/products.css">
</head>
<body>
  <nav>
    <ul>
      <li><a href="/">Dashboard</a></li>
      <li><a href="/order">Orders</a></li>
      <li><a href="/customer">Customers</a></li>
      <li><a href="/product">Products</a></li>
    </ul>
  </nav>

  <div class="main_header">
    <h1>Order Manager</h1>
  </div>

  <div class="header-container">
    <h2>Products</h2>
    <a href="/product/new" class="btn-primary">
      <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <line x1="5" y1="12" x2="19" y2="12"></line>
      </svg>
      New Product
    </a>
  </div>

  <div class="search-container">
    <form method="GET" action="/product" class="search-input-wrapper">
      <svg class="search-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <circle cx="11" cy="11" r="8"></circle>
        <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
      </svg>
      <input type="text" id="input-busca" name="search"value="<%= typeof search !== 'undefined' ? search : '' %>"placeholder="Search products by description, sku..."autocomplete="off">
    </form>
  </div>

  <table class="t-registros">
    <thead>
      <tr>
        <th>SKU</th>
        <th>Description</th>
        <th>Unit Price</th>
        <th>Stock Quantity</th>
        <th>Product Active</th>
        <th>Activation Date</th>
        <th>Deactivation Date</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody id="tbody-data">
      <% if (products.length === 0) { %>
        <tr>
          <td colspan="8" style="text-align: center; padding: 16px;">Oops! No products found.</td>
        </tr>
      <% } %>
      <% products.forEach(product => { %>
        <tr 
          data-sku="<%= product.sku %>" 
          data-price="<%= product.price %>"
          data-amount="<%= product.storage_amt %>"
          data-activated="<%= product.activated ? 'true' : 'false' %>"
          class="<%= product.activated ? '' : 'row-inactive' %>"
        >
          <td><%= product.sku %></td>
          <td><%= product.description %></td>
          <td class="cell-price"><%= product.price %></td>
          <td class="cell-amount"><%= product.storage_amt %></td>
          <td class="cell-status">
            <span class="status-badge <%= product.activated ? 'status-active' : 'status-inactive' %>">
              <%= product.activated ? 'Active' : 'Inactive' %>
            </span>
          </td>
          <td class="cell-activation-date"><%= product.activation_date || '-' %></td>
          <td class="cell-deactivated-at"><%= product.deactivated_at || '-' %></td>
          <td class="cell-actions">
            <div class="actions-wrapper">
              <button type="button" class="btn-action btn-edit">Edit</button>
            </div>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>

  <% 
    const queryPrefix = search ? `search=${encodeURIComponent(search)}&` : '';
  %>
  <div class="pagination-container">
    <div class="pagination-info">
      Page <strong><%= currentPage %></strong> of <strong><%= totalPages %></strong> 
      (<%= totalItems %> product<%= totalItems === 1 ? '' : 's' %>)
    </div>

    <div class="pagination-controls">
      <a 
        href="/product?<%= queryPrefix %>page=<%= currentPage - 1 %>" 
        class="page-link <%= currentPage <= 1 ? 'disabled' : '' %>"
      >
        Previous
      </a>

      <% for (let i = 1; i <= totalPages; i++) { %>
        <a 
          href="/product?<%= queryPrefix %>page=<%= i %>" 
          class="page-link <%= i === currentPage ? 'active' : '' %>"
        >
          <%= i %>
        </a>
      <% } %>

      <a 
        href="/product?<%= queryPrefix %>page=<%= currentPage + 1 %>" 
        class="page-link <%= currentPage >= totalPages ? 'disabled' : '' %>"
      >
        Next
      </a>
    </div>
  </div>

  <script src="/../js/main.js"></script>
  <script src="/../js/products/products.js"></script>
</body>
</html>