<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <meta charset="UTF-8">
  <title>Lista de Clientes</title>
  <!-- O caminho busca direto a partir do interior da pasta public/ -->
  <link rel="stylesheet" href="../css/new-customers.css">
</head>
<body>
<div class="header-container">
    <form action="/customer" method="POST" class="form-card">
  <div class="form-group">
    <label for="name">Nome completo</label>
    <input type="text" id="name" name="name" required placeholder="Ex: Maria Silva">
  </div>

  <div class="form-group">
    <label for="cpf">CPF</label>
    <input type="text" id="cpf" name="cpf" required placeholder="000.000.000-00">
  </div>

  <div class="form-group">
    <label for="email">E-mail</label>
    <input type="email" id="email" name="email" required placeholder="maria@email.com">
  </div>

  <div class="form-group">
    <label for="phone">Telefone</label>
    <input type="text" id="phone" name="phone" placeholder="(11) 99999-9999">
  </div>

  <!-- Endereço -->
  <div class="form-group">
    <label for="zipcode">CEP</label>
    <input type="text" id="zipcode" name="zipcode">
  </div>

  <div class="form-group">
    <label for="address">Endereço</label>
    <input type="text" id="address" name="address">
  </div>

  <div class="form-group">
    <label for="residence_number">Número</label>
    <input type="text" id="residence_number" name="residence_number">
  </div>

  <div class="form-group">
    <label for="neighborhood">Bairro</label>
    <input type="text" id="neighborhood" name="neighborhood">
  </div>

  <div class="form-group">
    <label for="city">Cidade</label>
    <input type="text" id="city" name="city">
  </div>

  <div class="form-group">
    <label for="state">Estado</label>
    <input type="text" id="state" name="state">
  </div>

  <div class="form-group">
    <label for="uf">UF</label>
    <input type="text" id="uf" name="uf" maxlength="2">
  </div>

  <div class="form-actions">
    <button type="submit" class="btn-primary">Salvar Cliente</button>
    <a href="/customer" class="btn-secondary">Voltar</a>
  </div>

</form>

  <script src="/../js/main.js"></script>
</body>
</html>